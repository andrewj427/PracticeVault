@page
@model PracticeVault.Pages.LibraryModel
@{
	ViewData["Title"] = "My Library";
}
<head>
    <link rel="stylesheet" href="~/css/Library.css" />
</head>
<div class="text-center">
    <h1 class="display-4">Library</h1>
</div>
<div class="d-flex align-items-center mb-3 flex-wrap gap-2">
    <input type="text" class="form-control flex-grow-1" placeholder="Search songs..." style="min-width: 200px;">

    <select class="form-select" style="width: auto;">
        <option value="">All Tunings</option>
        <option value="standard">Standard</option>
        <option value="drop">Drop</option>
        <option value="drop">Open</option>

    </select>

    <select class="form-select" style="width: auto;">
        <option value="">All Difficulties</option>
        <option value="easy">Easy</option>
        <option value="medium">Medium</option>
        <option value="hard">Hard</option>
        <option value="expert">Expert</option>
        <option value="expertplus">Expert+</option>


    </select>

    <select class="form-select" style="width: auto;">
        <option value="">All Statuses</option>
        <option value="learning">Learning</option>
        <option value="mastered">Mastered</option>
        <option value="needs-work">Needs Work</option>
        <option value="learn-later">Learn Later</option>

    </select>

    <a class="btn btn-primary" asp-page="/AddSong">Add Song</a>
</div>
<table class="table text-white" id="SongTable">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Song Name / Tab link</th>
            <th scope="col">Artist</th>
            <th scope="col">Difficulty</th>
            <th scope="col">Tuning</th>
            <th scope="col">Notes</th>
            <th scope="col">Status</th>
            <th scope="col"> </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var song in Model.Songs)
        {
            <tr>
                <td>@song.SongID</td>

                <td>
                    @if (!string.IsNullOrWhiteSpace(song.TabURL))
                    {
                        <a href="@song.TabURL"
                           target="_blank"
                           rel="noopener noreferrer">
                            @song.Title
                        </a>
                    }
                    else
                    {
                        @song.Title
                    }
            </td>

            <td>@song.Artist</td>

            <td>
                @(string.IsNullOrWhiteSpace(song.Difficulty)
                                ? "-"
                                : song.Difficulty)
                                              </td>

            <td>
                @(string.IsNullOrWhiteSpace(song.Tuning)
                                ? "-"
                                : song.Tuning)
                                          </td>

            <td>
                @(string.IsNullOrWhiteSpace(song.Notes)
                                ? "-"
                                : song.Notes)
                                         </td>

            <td>
                @(string.IsNullOrWhiteSpace(song.Status)
                                ? "-"
                                : song.Status)
            </td>

                <td>
                <td>
                    <a asp-page="/EditSong"
                       asp-route-id="@song.UserSongID"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>

                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@song.UserSongID"
                          class="d-inline"
                          onsubmit="return confirm('Remove this song from your library?');">

                        <button type="submit" class="btn btn-sm btn-danger">
                            Delete
                        </button>
                    </form>
                </td>
                </td>
            </tr>
                }
    </tbody>
</table>