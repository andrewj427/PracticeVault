@page
@model PracticeVault.Pages.AddSongModel
@{
    ViewData["Title"] = "Add Song";
}

<div class="song-form-page">
    <h2>Add a New Song</h2>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Song Title</label>
            <input asp-for="Song.Title"
                   class="form-control"
                   placeholder="Song title" />
        </div>

        <div class="mb-3">
            <label class="form-label">Artist</label>
            <input asp-for="Song.Artist"
                   class="form-control"
                   placeholder="Artist name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Album</label>
            <input asp-for="Song.Album"
                   class="form-control"
                   placeholder="Album (optional)" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Tuning</label>
                <div class="d-flex gap-2">
                    <select asp-for="Song.TuningNote"
                            class="form-select form-select-sm"
                            style="max-width: 90px;">
                        <option value="E">E</option>
                        <option value="Eb">Eb / D#</option>
                        <option value="D">D</option>
                        <option value="Db">Db / C#</option>
                        <option value="C">C</option>
                        <option value="B">B</option>
                        <option value="Bb">Bb / A#</option>
                        <option value="A">A</option>
                        <option value="Ab">Ab / G#</option>
                        <option value="G">G</option>
                        <option value="Gb">Gb / F#</option>
                        <option value="F">F</option>
                    </select>

                    <select asp-for="Song.TuningType" class="form-select">
                        <option value="Standard">Standard</option>
                        <option value="Drop">Drop</option>
                        <option value="Open">Open</option>
                        <option value="Other">Other</option>

                    </select>
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Difficulty</label>
                <select asp-for="Song.Difficulty" class="form-select">
                    <option value="">Select difficulty</option>
                    <option value="Easy">Easy</option>
                    <option value="Medium">Medium</option>
                    <option value="Hard">Hard</option>
                    <option value="Expert">Expert</option>
                    <option value="Expertplus">Expert+</option>

                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Status</label>
                <select asp-for="Song.Status" class="form-select">
                    <option value="Learn Later">Learn Later</option>
                    <option value="Learning">Learning</option>
                    <option value="Needs Work">Needs Work</option>
                    <option value="Mastered">Mastered</option>
                </select>
            </div>

        </div>

        <div class="mb-3">
            <label class="form-label">Tab Link</label>
            <input asp-for="Song.TabURL"
                   class="form-control"
                   placeholder="https://..." />
        </div>

        <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea asp-for="Song.Notes"
                      class="form-control"
                      rows="3"
                      placeholder="Practice notes..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Add Song</button>
        <a asp-page="/Library" class="btn btn-secondary">Cancel</a>
    </form>
</div>